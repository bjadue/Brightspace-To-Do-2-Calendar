{
  "name": "D2L To-Do to Calendar",
  "description": "Export Brightspace To-Do assignments to Calendar",
  "version": "0.0.72",
  "manifest_version": 3,
  "key": "",
  "action": {
    "default_popup": "main.html",
    "default_icon": "hello_extensions.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "/internalScripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/d2l/*"],
      "js": ["/internalScripts/gate.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["/internalScripts/scraper.js"],
      "matches": ["https://*/*"]
    },
    {
      "resources": ["/internalScripts/exporting.js"],
      "matches": ["https://*/*"]
    }
  ],
  "oauth2": {
    "client_id": "349374224255-q63c1apfg5v6lp8sganhubssof18debo.apps.googleusercontent.com",
    "scopes":[
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/calendar", 
      "https://www.googleapis.com/auth/calendar.calendarlist",
      "https://www.googleapis.com/auth/calendar.events.owned",
      "https://www.googleapis.com/auth/calendar.settings"
    ]
  }
}