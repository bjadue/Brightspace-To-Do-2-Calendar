{
  "name": "D2L To-Do to Calendar",
  "description": "Export Brightspace To-Do assignments to Calendar",
  "version": "0.0.71-ALPHA",
  "manifest_version": 3,
  "action": {
    "default_popup": "main.html",
    "default_icon": "hello_extensions.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/d2l/*"],
      "js": ["/internalScripts/gate.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["/internalScripts/scraper.js"],
      "matches": ["https://*/*"]
    },
    {
      "resources": ["/internalScripts/exporting.js"],
      "matches": ["https://*/*"]
    }
  ]
}