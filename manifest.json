{
  "name": "D2L Brightspace Export To-Do to Calendar",
  "description": "Export Brightspace To-Do assignments to Calendar",
  "version": "0.0.2",
  "manifest_version": 3,
  "action": {
    "default_popup": "main.html",
    "default_icon": "hello_extensions.png"
  },
  "permissions": [
    "storage",
    "background",
    "scripting",
    "activeTab",
    "tabs",
    "alarms"
  ]
}
